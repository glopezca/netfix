{
  "name": "netsim",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install --no-audit --no-fund",
  "postAttachCommand": {
    "netsim": "node scripts/serve.mjs --prebuilt"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "netsim",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-vscode.live-server"]
    }
  }
}
