  {
   "id": "d3",
   "kind": "router",
   "label": "SEDE-A",
   "x": 240,
   "y": 328,
   "seed": 3,
   "config": [
    "!",
    "version 15.1",
    "no service timestamps log datetime msec",
    "no service timestamps debug datetime msec",
    "no service password-encryption",
    "!",
    "hostname SEDE-A",
    "!",
    "ip dhcp excluded-address 192.168.10.1 192.168.10.9",
    "!",
    "ip dhcp pool LAN",
    " network 192.168.10.0 255.255.255.0",
    " default-router 192.168.10.1",
    " dns-server 8.8.8.8",
    "!",
    "!",
    "no ip domain-lookup",
    "ip cef",
    "no ipv6 cef",
    "!",
    "!",
    "crypto isakmp policy 10",
    " encr aes 256",
    " authentication pre-share",
    " group 5",
    "crypto isakmp key Netfix-VPN-2026 address 81.33.5.2",
    "!",
    "!",
    "crypto ipsec transform-set TS-AES esp-aes 256 esp-sha-hmac",
    "!",
    "crypto map VPN 10 ipsec-isakmp ",
    " set peer 81.33.5.2",
    " set transform-set TS-AES ",
    " match address VPN",
    "!",
    "interface GigabitEthernet0/0",
    " ip address 192.168.10.1 255.255.255.0",
    " ip nat inside",
    " duplex auto",
    " speed auto",
    "!",
    "interface GigabitEthernet0/1",
    " description Linea publica del ISP",
    " ip address dhcp",
    " ip nat outside",
    " duplex auto",
    " speed auto",
    " crypto map VPN",
    "!",
    "interface GigabitEthernet0/2",
    " no ip address",
    " duplex auto",
    " speed auto",
    " shutdown",
    "!",
    "interface Vlan1",
    " no ip address",
    " shutdown",
    "!",
    "ip nat inside source list NAT interface GigabitEthernet0/1 overload",
    "ip classless",
    "!",
    "ip flow-export version 9",
    "!",
    "ip access-list extended NAT",
    " remark el trafico entre sedes va por el tunel, sin NAT",
    " deny ip 192.168.10.0 0.0.0.255 192.168.20.0 0.0.0.255",
    " permit ip 192.168.10.0 0.0.0.255 any",
    "ip access-list extended VPN",
    " permit ip 192.168.10.0 0.0.0.255 192.168.20.0 0.0.0.255",
    "!",
    "!",
    "line con 0",
    "!",
    "line aux 0",
    "!",
    "line vty 0 4",
    " login",
    "!",
    "!",
    "!",
    "end"
   ],
   "startup": null
  },
