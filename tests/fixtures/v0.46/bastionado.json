  {
   "id": "d1",
   "kind": "router",
   "label": "GW",
   "x": 460,
   "y": 140,
   "seed": 1,
   "config": [
    "!",
    "version 15.1",
    "no service timestamps log datetime msec",
    "no service timestamps debug datetime msec",
    "no service password-encryption",
    "!",
    "hostname GW",
    "!",
    "enable secret 5 $1$mERr$1j2jevf10",
    "!",
    "!",
    "no ip domain-lookup",
    "ip cef",
    "no ipv6 cef",
    "!",
    "!",
    "interface GigabitEthernet0/0",
    " description ADMINISTRACION",
    " ip address 192.168.10.1 255.255.255.0",
    " duplex auto",
    " speed auto",
    "!",
    "interface GigabitEthernet0/1",
    " description ALUMNOS",
    " ip address 192.168.20.1 255.255.255.0",
    " duplex auto",
    " speed auto",
    "!",
    "interface GigabitEthernet0/2",
    " description SERVIDORES",
    " ip address 172.20.0.1 255.255.255.0",
    " ip access-group A-SERVIDORES out",
    " duplex auto",
    " speed auto",
    "!",
    "interface Vlan1",
    " no ip address",
    " shutdown",
    "!",
    "ip classless",
    "!",
    "ip flow-export version 9",
    "!",
    "ip access-list extended A-SERVIDORES",
    " remark la web es para todos; SSH y ping solo desde administracion",
    " permit tcp any host 172.20.0.10 eq www",
    " permit tcp 192.168.10.0 0.0.0.255 host 172.20.0.10 eq 22",
    " permit icmp 192.168.10.0 0.0.0.255 any",
    " permit udp any host 172.20.0.10 eq domain",
    " deny ip any any log",
    "!",
    "!",
    "line con 0",
    "!",
    "line aux 0",
    "!",
    "line vty 0 4",
    " login",
    "!",
    "!",
    "!",
    "end"
   ],
   "startup": null
  },
